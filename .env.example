# Private server-side configuration. Copy to .env.local manually; never commit real values.
RESEND_API_KEY=
# test: local/Preview only, no delivery to the production inbox by default.
# live: requires a verified sending domain and explicit CONTACT_FROM_EMAIL.
CONTACT_EMAIL_MODE=test
CONTACT_FROM_EMAIL=web@burgosinmotion.com
CONTACT_TO_EMAIL=hola@burgosinmotion.com
# Resend's simulated recipient. Use your Resend account email for an inbox test.
CONTACT_TEST_TO_EMAIL=delivered@resend.dev

# Required on Vercel and with next start; no service is provisioned automatically.
# Only short-lived rate counters are stored, never form contents.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a private random value of at least 32 characters.
CONTACT_RATE_LIMIT_SALT=
